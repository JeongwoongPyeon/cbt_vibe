{
  "name": "cbt_vibe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env server/index.ts --dev",
    "dev:all": "node scripts/start-all.mjs",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/tests/*.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-popover": "1.1.23",
    "cmdk": "1.1.1",
    "chart.js": "4.5.1",
    "@fontsource/noto-sans-kr": "5.3.0",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.7",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "0.18.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
